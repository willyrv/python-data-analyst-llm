# Serveur utilisé au démarrage. L'interface peut le changer sans redémarrer.
# Torus / Open WebUI : https://gentl.torus.ai/api
# OpenAI             : https://api.openai.com/v1
# Google Gemini      : https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama             : http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=dummy
MODEL_NAME=your-local-model

# Clés préremplies au démarrage. Le fichier réel est .secrets/llm-api-keys.env
# (ignoré par git). OPENAI_API_KEY ci-dessus reste celle du serveur de départ.
TORUS_API_KEY=
OPENAI_CLOUD_API_KEY=
GEMINI_API_KEY=

# L'application utilise uniquement l'utilisateur en lecture seule.
DATABASE_URL=postgresql+psycopg://olist_ro:olist_ro@localhost:5432/olist

# Scripts de chargement et de création du rôle lecture seule.
DATABASE_ADMIN_URL=postgresql+psycopg://olist:olist@localhost:5432/olist
READONLY_DB_USER=olist_ro
READONLY_DB_PASSWORD=olist_ro

DEBUG=false
TEMPERATURE=0.1
MAX_TOOL_ROUNDS=6
LLM_TIMEOUT_S=120
SQL_ROW_LIMIT=200
SQL_TIMEOUT_MS=15000
CHART_DIR=outputs/charts
